<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd">

    <bean id="cxdevformsBackofficeLabelLocator" class="com.hybris.cockpitng.util.labels.ResourcesLabelLocator" scope="singleton" init-method="init" lazy-init="false">
        <property name="location" value="/cxdevforms-backoffice-labels/"/>
        <property name="name" value="labels"/>
    </bean>
    <bean id="cxDynamicFormSubmissionRenderer" class="me.cxdev.commerce.forms.backoffice.renderers.DynamicFormSubmissionRenderer">
        <constructor-arg ref="cxDynamicFormSubmissionPresentationService"/>
    </bean>
</beans>
