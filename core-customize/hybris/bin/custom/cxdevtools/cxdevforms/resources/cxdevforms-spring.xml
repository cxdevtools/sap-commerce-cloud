<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd">
    <import resource="cxdevforms/cxdevforms-services-spring.xml"/>
    <import resource="cxdevforms/cxdevforms-facades-spring.xml"/>
    <import resource="cxdevforms/cxdevforms-submissions-spring.xml"/>

    <bean id="cxDynamicFormFieldValuePrepareInterceptor"
          class="me.cxdev.commerce.forms.interceptors.DynamicFormFieldValuePrepareInterceptor"/>
    <bean id="cxDynamicFormFieldUuidPrepareInterceptor"
          class="me.cxdev.commerce.forms.interceptors.DynamicFormFieldUuidPrepareInterceptor"/>
    <bean id="cxDynamicFormStepUuidPrepareInterceptor"
          class="me.cxdev.commerce.forms.interceptors.DynamicFormStepUuidPrepareInterceptor"/>
    <bean id="cxDynamicFormFieldStepValidateInterceptor"
          class="me.cxdev.commerce.forms.interceptors.DynamicFormFieldStepValidateInterceptor"/>
    <bean id="cxDynamicFormFieldUuidPrepareInterceptorMapping"
          class="de.hybris.platform.servicelayer.interceptor.impl.InterceptorMapping">
        <property name="interceptor" ref="cxDynamicFormFieldUuidPrepareInterceptor"/>
        <property name="typeCode" value="DynamicFormField"/>
    </bean>
    <bean id="cxDynamicFormFieldValuePrepareInterceptorMapping"
          class="de.hybris.platform.servicelayer.interceptor.impl.InterceptorMapping">
        <property name="interceptor" ref="cxDynamicFormFieldValuePrepareInterceptor"/>
        <property name="typeCode" value="DynamicFormFieldValue"/>
    </bean>
    <bean id="cxDynamicFormStepUuidPrepareInterceptorMapping"
          class="de.hybris.platform.servicelayer.interceptor.impl.InterceptorMapping">
        <property name="interceptor" ref="cxDynamicFormStepUuidPrepareInterceptor"/>
        <property name="typeCode" value="DynamicFormStep"/>
    </bean>
    <bean id="cxDynamicFormFieldStepValidateInterceptorMapping"
          class="de.hybris.platform.servicelayer.interceptor.impl.InterceptorMapping">
        <property name="interceptor" ref="cxDynamicFormFieldStepValidateInterceptor"/>
        <property name="typeCode" value="DynamicFormField"/>
    </bean>
</beans>
