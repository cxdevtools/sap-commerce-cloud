                    <y:action action-id="com.hybris.cockpitng.listview.action.export.csv" merge-mode="remove"/>
                </y:group>
                <y:extended-group qualifier="export" show-group-header="false" position="30">
                    <y:action action-id="com.hybris.backoffice.widgets.actions.excel.export" position="10" property="pageable.typeCode"/>
                    <y:action action-id="com.hybris.cockpitng.listview.action.export.csv" position="20" property="exportColumnsAndData">
