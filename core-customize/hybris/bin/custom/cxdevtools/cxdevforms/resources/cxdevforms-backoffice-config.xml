                    <advanced-search:field name="label" selected="true" operator="contains"/>
                    <advanced-search:field name="childFields" selected="true" operator="contains"/>
                </advanced-search:field-list>
            </advanced-search:advanced-search>
        </context>
        <context component="listview" merge-by="type">
            <list-view:list-view>
                <list-view:column qualifier="id"/>
                <list-view:column qualifier="label"/>
                <list-view:column qualifier="childFields"/>
            </list-view:list-view>
        </context>
        <context component="listviewactions" merge-by="type">
