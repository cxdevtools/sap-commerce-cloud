                    <y:action action-id="com.hybris.cockpitng.listview.action.export.csv" position="20" property="exportColumnsAndData">
                        <y:parameter>
                            <yc:name>actionName</yc:name>
                            <yc:value>label.export.csv</yc:value>
                        </y:parameter>
                    </y:action>
                    <y:extended-action action-id="com.hybris.backoffice.widgets.actions.excel.export" position="40"/>
                </y:extended-group>
                <y:group qualifier="import" show-group-header="false" position="40">
                    <y:action action-id="com.hybris.backoffice.widgets.actions.excel.import" position="10" property="pageable.typeCode"/>
                </y:group>
            </y:actions>
        </context>
        <context component="editor-area" merge-by="type">
            <editorArea:editorArea>
                <editorArea:essentials>
                    <editorArea:essentialSection name="hmc.essential">
                        <editorArea:attribute qualifier="id"/>
                    </editorArea:essentialSection>
                </editorArea:essentials>
                <editorArea:tab name="hmc.tab.common">
                    <editorArea:section name="hmc.properties">
                        <editorArea:attribute qualifier="label"/>
                        <editorArea:attribute qualifier="description"/>
                        <editorArea:attribute qualifier="required"/>
                        <editorArea:attribute qualifier="hidden"/>
                        <editorArea:attribute qualifier="active"/>
                        <editorArea:attribute qualifier="fieldType"/>
                        <editorArea:attribute qualifier="minValue"/>
                        <editorArea:attribute qualifier="maxValue"/>
                        <editorArea:attribute qualifier="minLength"/>
                        <editorArea:attribute qualifier="maxLength"/>
                        <editorArea:attribute qualifier="defaultValue"/>
                        <editorArea:attribute qualifier="placeholder"/>
                        <editorArea:attribute qualifier="stepId"/>
                        <editorArea:attribute qualifier="stepTitle"/>
                        <editorArea:attribute qualifier="formFieldValues"/>
                        <editorArea:attribute qualifier="form"/>
                        <editorArea:attribute qualifier="parentFieldValues"/>
                    </editorArea:section>
                </editorArea:tab>
            </editorArea:editorArea>
        </context>
        <context component="create-wizard" merge-by="type">
            <wz:flow id="DynamicFormFieldWizard" title="create.title(ctx.TYPE_CODE)">
                <wz:prepare id="itemPrepare">
                    <wz:initialize property="newObject" type="ctx.TYPE_CODE"/>
                </wz:prepare>
                <wz:step id="step1" label="flow.allmanadatory">
                    <wz:content id="step1.content">
                        <wz:property-list root="newObject">
                            <wz:property qualifier="id"/>
                            <wz:property qualifier="label"/>
                            <wz:property qualifier="description"/>
                            <wz:property qualifier="required"/>
                            <wz:property qualifier="active"/>
                            <wz:property qualifier="hidden"/>
                            <wz:property qualifier="fieldType"/>
                            <wz:property qualifier="minValue"/>
                            <wz:property qualifier="maxValue"/>
                            <wz:property qualifier="maxLength"/>
                            <wz:property qualifier="minLength"/>
                            <wz:property qualifier="defaultValue"/>
