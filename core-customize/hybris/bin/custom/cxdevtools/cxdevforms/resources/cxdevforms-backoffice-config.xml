    <context type="DynamicFormSubmission" merge-by="type" module="cxdevforms">
        <context component="base"><y:base><y:labels><y:label>id</y:label></y:labels></y:base></context>
        <context component="simple-search"><simple-search:simple-search><simple-search:field name="id"/></simple-search:simple-search></context>
        <context component="advanced-search">
            <advanced-search:advanced-search><advanced-search:field-list>
                <advanced-search:field name="form" selected="true" operator="equals"/>
                <advanced-search:field name="submittedAt" selected="true"/>
                <advanced-search:field name="user" selected="true" operator="equals"/>
                <advanced-search:field name="baseSite" selected="true" operator="equals"/>
            </advanced-search:field-list></advanced-search:advanced-search>
        </context>
        <context component="listview"><list-view:list-view>
            <list-view:column qualifier="id"/>
            <list-view:column qualifier="form"/>
            <list-view:column qualifier="submittedAt"/>
            <list-view:column qualifier="user"/>
            <list-view:column qualifier="baseSite"/>
        </list-view:list-view></context>
        <context component="editor-area">
            <editorArea:editorArea>
                <editorArea:essentials><editorArea:essentialSection name="hmc.essential">
                    <editorArea:attribute qualifier="id" readonly="true"/>
                    <editorArea:attribute qualifier="form" readonly="true"/>
                    <editorArea:attribute qualifier="submittedAt" readonly="true"/>
                </editorArea:essentialSection></editorArea:essentials>
                <editorArea:tab name="cxdevforms.submission.answers">
                    <editorArea:customSection name="cxdevforms.submission.answers" spring-bean="cxDynamicFormSubmissionRenderer"/>
                </editorArea:tab>
                <editorArea:tab name="cxdevforms.submission.metadata">
                    <editorArea:section name="cxdevforms.submission.metadata">
                        <editorArea:attribute qualifier="user" readonly="true"/>
                        <editorArea:attribute qualifier="baseSite" readonly="true"/>
                        <editorArea:attribute qualifier="language" readonly="true"/>
                        <editorArea:attribute qualifier="userAgent" readonly="true"/>
                        <editorArea:attribute qualifier="remoteAddress" readonly="true"/>
                    </editorArea:section>
                </editorArea:tab>
                <editorArea:tab name="cxdevforms.submission.raw">
                    <editorArea:section name="cxdevforms.submission.raw">
                        <editorArea:attribute qualifier="answersJson" readonly="true"/>
                        <editorArea:attribute qualifier="definitionSnapshotJson" readonly="true"/>
                    </editorArea:section>
                </editorArea:tab>
            </editorArea:editorArea>
        </context>
    </context>
</config>
