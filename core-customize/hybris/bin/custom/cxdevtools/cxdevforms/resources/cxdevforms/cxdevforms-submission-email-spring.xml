<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd">

    <!-- NOT imported by default. Import this resource from project Spring configuration to enable email. -->
    <bean id="cxDynamicFormSubmissionEmailListener" parent="abstractEventListener"
          class="me.cxdev.commerce.forms.event.DynamicFormSubmissionEmailListener">
        <constructor-arg ref="modelService"/>
        <constructor-arg ref="htmlEmailGenerator"/>
        <constructor-arg ref="htmlEmailService"/>
        <constructor-arg ref="cxDynamicFormSubmissionSnapshotService"/>
        <constructor-arg ref="cxDynamicFormSubmissionPresentationService"/>
        <constructor-arg ref="cxDynamicFormSubmissionMessageSource"/>
    </bean>
</beans>
