<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd">

    <alias name="cxDynamicFormService" alias="dynamicFormService"/>
    <bean id="cxDynamicFormService" class="me.cxdev.commerce.forms.service.impl.DefaultDynamicFormService">
        <constructor-arg name="dynamicFormDao">
            <bean class="de.hybris.platform.servicelayer.internal.dao.DefaultGenericDao">
                <constructor-arg name="typecode" value="DynamicForm"/>
            </bean>
        </constructor-arg>
    </bean>

</beans>
