INSERT_UPDATE DynamicForm; id[unique = true]; type(code); title[lang = en]; title[lang = de]; description[lang = en]; description[lang = de]
                             ; $showcaseForm   ; CONTACT   ; Contact form – field type showcase; Kontaktformular – Feldtypen-Showcase; Demonstrates every available DynamicFormFieldType.; Demonstriert alle verfügbaren DynamicFormFieldType.
                             ; $conditionalForm; CONTACT   ; Contact form – conditional scenarios; Kontaktformular – abhängige Szenarien; Demonstrates conditional fields over three levels.; Demonstriert abhängige Felder über drei Ebenen.

# 1. Contact form with every DynamicFormFieldType
INSERT_UPDATE DynamicFormField; id[unique = true]; form(id); fieldType(code); label[lang = en]; label[lang = de]; description[lang = en]; description[lang = de]; placeholder[lang = en]; placeholder[lang = de]; defaultValue; active; hidden; required
                              ; $showcaseText      ; $showcaseForm; TEXT      ; Your name; Ihr Name; TEXT: Enter the name we should use when contacting you.; TEXT: Geben Sie den Namen ein, mit dem wir Sie ansprechen dürfen.; Jane Doe; Erika Mustermann; ; true; false; false
                              ; $showcaseEmail     ; $showcaseForm; EMAIL     ; Email address; E-Mail-Adresse; EMAIL: Tell us where we can send our reply.; EMAIL: Geben Sie an, wohin wir unsere Antwort senden dürfen.; jane@example.com; erika@example.de; ; true; false; false
                              ; $showcaseTextArea  ; $showcaseForm; TEXTAREA  ; Your message; Ihre Nachricht; TEXTAREA: Describe your request in your own words.; TEXTAREA: Beschreiben Sie Ihr Anliegen mit eigenen Worten.; How can we help?; Wie können wir helfen?; ; true; false; false
                              ; $showcaseNumber    ; $showcaseForm; NUMBER    ; Number of participants; Anzahl der Teilnehmenden; NUMBER: Estimate how many people are involved in your request.; NUMBER: Schätzen Sie, wie viele Personen von Ihrem Anliegen betroffen sind.; 1; 1; 1; true; false; false
                              ; $showcaseDate      ; $showcaseForm; DATE      ; Preferred appointment; Wunschtermin; DATE: Choose a suitable date for a call.; DATE: Wählen Sie ein passendes Datum für einen Rückruf.; ; ; ; true; false; false
                              ; $showcaseWeek      ; $showcaseForm; WEEK      ; Preferred calendar week; Bevorzugte Kalenderwoche; WEEK: Select the week in which we should contact you.; WEEK: Wählen Sie die Kalenderwoche für unsere Kontaktaufnahme.; ; ; ; true; false; false
                              ; $showcasePassword  ; $showcaseForm; PASSWORD  ; Callback code; Rückruf-Code; PASSWORD: A confidential code for identifying your request.; PASSWORD: Ein vertraulicher Code zur Zuordnung Ihres Anliegens.; ; ; ; true; false; false
                              ; $showcaseHidden    ; $showcaseForm; HIDDEN    ; Internal reference; Interne Referenz; HIDDEN: A technical value supplied by the frontend.; HIDDEN: Ein technischer Wert, der vom Frontend gesetzt wird.; contact-demo; kontakt-demo; contact-demo; true; false; false
                              ; $showcaseColor     ; $showcaseForm; COLOR     ; Preferred colour; Wunschfarbe; COLOR: Pick a colour for the requested material.; COLOR: Wählen Sie eine Farbe für die gewünschten Unterlagen.; ; ; #4b8eff; true; false; false
                              ; $showcaseSelect    ; $showcaseForm; SELECT    ; Preferred contact channel; Bevorzugter Kontaktweg; SELECT: Choose how you would like to hear from us.; SELECT: Wählen Sie, wie wir Sie kontaktieren dürfen.; ; ; $selectEmail; true; false; false
                              ; $showcaseRadio     ; $showcaseForm; RADIO     ; Reply detail; Antwortumfang; RADIO: Decide how detailed our reply should be.; RADIO: Entscheiden Sie, wie ausführlich unsere Antwort sein soll.; ; ; $radioQuick; true; false; false
                              ; $showcaseCheckbox  ; $showcaseForm; CHECKBOX  ; Callback consent; Rückruf erlaubt; CHECKBOX: Confirm whether we may call you back.; CHECKBOX: Bestätigen Sie, ob wir Sie zurückrufen dürfen.; ; ; false; true; false; false
                              ; $showcaseCheckboxes; $showcaseForm; CHECKBOXES; Areas of interest; Interessensgebiete; CHECKBOXES: Select all topics that are relevant to you.; CHECKBOXES: Wählen Sie alle Themen, die für Sie relevant sind.; ; ; $interestProduct,$interestSupport; true; false; false
                              ; $showcaseFile      ; $showcaseForm; FILE      ; Attachment; Anhang; FILE: Upload a screenshot or a document if it helps explain your request.; FILE: Laden Sie bei Bedarf einen Screenshot oder ein Dokument hoch.; ; ; ; true; false; false

INSERT_UPDATE DynamicFormFieldValue; id[unique = true]; field(id); label[lang = en]; label[lang = de]
                                   ; $selectEmail        ; $showcaseSelect    ; Email; E-Mail
                                   ; $selectPhone        ; $showcaseSelect    ; Phone; Telefon
                                   ; $selectVideo        ; $showcaseSelect    ; Video call; Videoanruf
                                   ; $radioQuick         ; $showcaseRadio     ; Short answer; Kurze Antwort
                                   ; $radioDetailed      ; $showcaseRadio     ; Detailed answer; Ausführliche Antwort
                                   ; $interestProduct    ; $showcaseCheckboxes; Product information; Produktinformationen
                                   ; $interestSupport    ; $showcaseCheckboxes; Technical support; Technischer Support
                                   ; $interestNewsletter ; $showcaseCheckboxes; Newsletter; Newsletter

# 2. Contact form with conditional fields: scenario -> topic -> detail
# The import is intentionally layered so each parent value exists before a
# dependent child field references it.
INSERT_UPDATE DynamicFormField; id[unique = true]; form(id); fieldType(code); parentFieldValue(id); label[lang = en]; label[lang = de]; description[lang = en]; description[lang = de]; placeholder[lang = en]; placeholder[lang = de]; defaultValue; active; hidden; required
                              ; $conditionalScenario; $conditionalForm; SELECT    ;                     ; What is your request about?; Worum geht es in Ihrem Anliegen?; SELECT: Choose a scenario to reveal the appropriate follow-up questions.; SELECT: Wählen Sie ein Szenario, um passende Folgefragen anzuzeigen.; ; ; $scenarioAdvice; true; false; false

INSERT_UPDATE DynamicFormFieldValue; id[unique = true]; field(id); label[lang = en]; label[lang = de]
                                   ; $scenarioAdvice      ; $conditionalScenario; Product or service advice; Produkt- oder Serviceberatung
                                   ; $scenarioSupport     ; $conditionalScenario; Technical support; Technischer Support
                                   ; $scenarioEvent       ; $conditionalScenario; Event request; Veranstaltungsanfrage

INSERT_UPDATE DynamicFormField; id[unique = true]; form(id); fieldType(code); parentFieldValue(id); label[lang = en]; label[lang = de]; description[lang = en]; description[lang = de]; placeholder[lang = en]; placeholder[lang = de]; defaultValue; active; hidden; required
                              ; $adviceType         ; $conditionalForm; SELECT    ; $scenarioAdvice     ; What kind of advice do you need?; Welche Beratung benötigen Sie?; SELECT: Select the advice format that fits your situation.; SELECT: Wählen Sie das Beratungsformat, das zu Ihrer Situation passt.; ; ; $adviceIndividual; true; false; false
                              ; $supportTopic       ; $conditionalForm; RADIO     ; $scenarioSupport    ; Support topic; Support-Thema; RADIO: Choose the part of the service you need help with.; RADIO: Wählen Sie den Bereich, bei dem Sie Unterstützung benötigen.; ; ; $supportLogin; true; false; false
                              ; $eventFormat        ; $conditionalForm; CHECKBOXES; $scenarioEvent      ; Event format; Veranstaltungsformat; CHECKBOXES: Select one or more formats you are considering.; CHECKBOXES: Wählen Sie ein oder mehrere Formate, die Sie in Betracht ziehen.; ; ; ; true; false; false

INSERT_UPDATE DynamicFormFieldValue; id[unique = true]; field(id); label[lang = en]; label[lang = de]
                                   ; $adviceIndividual    ; $adviceType         ; Individual consultation; Individuelle Beratung
                                   ; $adviceTraining      ; $adviceType         ; Training; Schulung
                                   ; $supportLogin        ; $supportTopic       ; Login problem; Anmeldeproblem
                                   ; $supportIntegration  ; $supportTopic       ; Integration problem; Integrationsproblem
                                   ; $eventOnsite         ; $eventFormat        ; On-site event; Veranstaltung vor Ort
                                   ; $eventOnline         ; $eventFormat        ; Online event; Online-Veranstaltung

INSERT_UPDATE DynamicFormField; id[unique = true]; form(id); fieldType(code); parentFieldValue(id); label[lang = en]; label[lang = de]; description[lang = en]; description[lang = de]; placeholder[lang = en]; placeholder[lang = de]; defaultValue; active; hidden; required
                              ; $adviceDetails      ; $conditionalForm; TEXTAREA  ; $adviceIndividual   ; Your requirements; Ihre Anforderungen; TEXTAREA: Describe the goals for your individual consultation.; TEXTAREA: Beschreiben Sie die Ziele für Ihre individuelle Beratung.; What should the consultation cover?; Was soll die Beratung abdecken?; ; true; false; false
                              ; $supportLog         ; $conditionalForm; FILE      ; $supportIntegration ; Log file; Log-Datei; FILE: Upload the relevant log file for integration support.; FILE: Laden Sie die passende Log-Datei für den Integrationssupport hoch.; ; ; ; true; false; false
                              ; $eventDate          ; $conditionalForm; DATE      ; $eventOnsite        ; Desired event date; Gewünschtes Veranstaltungsdatum; DATE: Pick a date for an on-site event.; DATE: Wählen Sie ein Datum für eine Veranstaltung vor Ort.; ; ; ; true; false; false

# Keep the visual order deterministic for both forms and all option lists.
UPDATE DynamicForm; id[unique = true]; formFields(id)[mode = replace]
                  ; $showcaseForm   ; $showcaseText,$showcaseEmail,$showcaseTextArea,$showcaseNumber,$showcaseDate,$showcaseWeek,$showcasePassword,$showcaseHidden,$showcaseColor,$showcaseSelect,$showcaseRadio,$showcaseCheckbox,$showcaseCheckboxes,$showcaseFile
                  ; $conditionalForm; $conditionalScenario,$adviceType,$adviceDetails,$supportTopic,$supportLog,$eventFormat,$eventDate

UPDATE DynamicFormField; id[unique = true]; formFieldValues(id)[mode = replace]
                       ; $showcaseSelect    ; $selectEmail,$selectPhone,$selectVideo
                       ; $showcaseRadio     ; $radioQuick,$radioDetailed
                       ; $showcaseCheckboxes; $interestProduct,$interestSupport,$interestNewsletter
                       ; $conditionalScenario; $scenarioAdvice,$scenarioSupport,$scenarioEvent
                       ; $adviceType         ; $adviceIndividual,$adviceTraining
                       ; $supportTopic       ; $supportLogin,$supportIntegration
                       ; $eventFormat        ; $eventOnsite,$eventOnline

UPDATE DynamicFormFieldValue; id[unique = true]; childFields(id)[mode = replace]
                                   ; $scenarioAdvice     ; $adviceType
                                   ; $adviceIndividual   ; $adviceDetails
                                   ; $scenarioSupport    ; $supportTopic
                                   ; $supportIntegration ; $supportLog
                                   ; $scenarioEvent      ; $eventFormat
                                   ; $eventOnsite        ; $eventDate
